      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 12 },
      "id": 11,
      "targets": [
        { "expr": "finora_gemini_latency_seconds{quantile=\"0.95\"}", "legendFormat": "Gemini p95 Latency" }
      ],
      "title": "Google Gemini AI Inference Latency (p95)",
      "type": "timeseries"
