            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 12 },
      "id": 12,
      "targets": [
        { "expr": "finora_storage_usage_ratio * 100", "legendFormat": "Private Storage Usage %" }
