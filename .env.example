# ==============================================================================
# Finora — Environment Configuration Template
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development
PROJECT_NAME="Finora — Financial Reconciliation & Revenue Leakage Engine"
SECRET_KEY="replace-this-with-a-very-long-and-cryptographically-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default (works zero-dependency):
DATABASE_URL=sqlite:///./finora.db
SYNC_DATABASE_URL=sqlite:///./finora.db
# PostgreSQL Production Example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finora
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finora

# Redis & Background Workers
REDIS_URL=redis://localhost:6379/0
WORKER_FALLBACK_SYNC=true

# AI Forensic Investigation Engine (Configurable)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_API_KEY=your-gemini-or-openai-api-key-here
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2048

# Financial Domain Defaults (Overridable per Tenant)
DEFAULT_CURRENCY=INR
DEFAULT_FEE_OVERCHARGE_TOLERANCE=0.05
DEFAULT_SETTLEMENT_CUTOFF_TIME=23:00
DEFAULT_MAX_KNAPSACK_BOUND=5

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
