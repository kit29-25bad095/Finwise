# ==============================================================================
# FINORA — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Security Notice:
# 1. NEVER commit this file with real secrets to version control.
# 2. Store production secrets in a dedicated secrets manager (AWS Secrets Manager,
#    GCP Secret Manager, HashiCorp Vault, or Docker Secrets).
# 3. All passwords and cryptographic keys must be generated using high-entropy random bytes:
#    e.g., `openssl rand -hex 32`
# ==============================================================================

# --- Application Runtime & Environment ---
ENVIRONMENT=production
PROJECT_NAME="Finora — Financial Reconciliation & Revenue Leakage Engine"

# --- Cryptographic & JWT Security ---
# Mandatory in production: at least 32 cryptographically random characters.
# Must NOT contain default test phrases (e.g., 'super-secure').
SECRET_KEY=generate_with_openssl_rand_hex_32_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=True
COOKIE_SAMESITE=lax

# Upload & Ingestion Constraints
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# --- Private Financial Document Storage ---
# Stored outside webroot on dedicated private volume.
# Enforces POSIX 0700 permissions and tenant isolation.
FINORA_STORAGE_DIR=/var/finora/storage
# Statutory retention period in days (7 years = 2555 days under Indian tax law)
FILE_RETENTION_DAYS=2555

# --- PostgreSQL Database (Production Managed RDS / Cloud SQL or Dedicated Container) ---
# NOTE: SQLite is strictly prohibited when ENVIRONMENT=production.
POSTGRES_USER=finora_admin
POSTGRES_PASSWORD=generate_high_entropy_postgres_password_here
POSTGRES_DB=finora_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
SYNC_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=True
DB_ECHO=False
# Use 'require' or 'verify-full' for cloud managed database SSL connections:
# DB_SSL_MODE=require

# --- Redis Queue & Broker Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=generate_high_entropy_redis_password_here
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# Worker Fallback: MUST be False in production to prevent silent synchronous blocking
WORKER_FALLBACK_SYNC=False

# --- Google Gemini AI Investigation Engine ---
# Configured via GEMINI_API_KEY. Never expose or log this key.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=AIzaSy_your_live_google_gemini_api_key_here
AI_API_KEY=AIzaSy_your_live_google_gemini_api_key_here
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2048

# Forensic Investigation Leases & Outbox
FORENSIC_LEASE_DURATION_SECONDS=300
FORENSIC_HEARTBEAT_INTERVAL_SECONDS=60
FORENSIC_MAX_EXECUTION_ATTEMPTS=3
FORENSIC_OUTBOX_BATCH_SIZE=50
FORENSIC_OUTBOX_LEASE_SECONDS=60

# --- Financial Engine Defaults ---
DEFAULT_CURRENCY=INR
DEFAULT_FEE_OVERCHARGE_TOLERANCE=0.05
DEFAULT_SETTLEMENT_CUTOFF_TIME=23:00
DEFAULT_MAX_KNAPSACK_BOUND=5

# --- CORS & Domain Allowlist ---
# Wildcards ('*') are strictly prohibited in production.
# Include only your verified production web domains.
BACKEND_CORS_ORIGINS=["https://app.finora.in","https://finora.in"]

# --- Frontend Settings ---
NEXT_PUBLIC_API_URL=/api/v1
